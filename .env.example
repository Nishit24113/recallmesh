# Copy to .env and fill in. Never commit .env. Not needed for local development.

# --- Polygon Amoy deployment (the only required values) ---
AMOY_RPC_URL=https://rpc-amoy.polygon.technology   # or an Alchemy/Infura Amoy endpoint
PRIVATE_KEY=0x...                                  # deployer (fund it from the Amoy faucet); also the oracle signer by default

# --- Optional overrides ---
ORACLE_PRIVATE_KEY=                                # separate lab/regulator signer (default: PRIVATE_KEY)
ARBITER_ADDRESS=                                   # dispute arbiter (default: deployer)
BOND_PER_UNIT=0.0001                               # POL locked per unit produced
LIABILITY_PERIOD_DAYS=30
CHALLENGE_WINDOW_SECONDS=900
